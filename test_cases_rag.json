  {
    "id": "test_008",
    "question": "2025年各季度的UV对比",
    "expected_sql": "SELECT CASE WHEN month BETWEEN '2025-01' AND '2025-03' THEN 'Q1' WHEN month BETWEEN '2025-04' AND '2025-06' THEN 'Q2' WHEN month BETWEEN '2025-07' AND '2025-09' THEN 'Q3' WHEN month BETWEEN '2025-10' AND '2025-12' THEN 'Q4' END AS quarter, COUNT(DISTINCT user_id) AS uv FROM dws_user_activity WHERE month BETWEEN '2025-01' AND '2025-12' GROUP BY CASE WHEN month BETWEEN '2025-01' AND '2025-03' THEN 'Q1' WHEN month BETWEEN '2025-04' AND '2025-06' THEN 'Q2' WHEN month BETWEEN '2025-07' AND '2025-09' THEN 'Q3' WHEN month BETWEEN '2025-10' AND '2025-12' THEN 'Q4' END ORDER BY quarter",
    "expected_result": [
      {
        "quarter": "Q1",
        "uv": 3
      },
      {
        "quarter": "Q2",
        "uv": 3
      },
      {
        "quarter": "Q3",
        "uv": 4
      },
      {
        "quarter": "Q4",
        "uv": 3
      }
    ],
    "expected_metrics": [
      "uv"
    ],
    "expected_time_filter": "2025-01,2025-12",
    "expected_group_by": [
      "quarter"
    ],
    "category": "quarterly_comparison",
    "description": "季度对比查询",
    "expected_rag_entities": [
      "uv",
      "quarter"
    ],
    "expected_rag_concepts": [
      "独立访客",
      "季度对比"
    ],
    "time_clarification": {
      "expected_input": "2025-01,2025-12",
      "description": "模拟用户澄清时间范围"
    }
  },
