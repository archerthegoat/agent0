          "device_type",
          "user_level",
          "platform"
        ]
      },
      {
        "metric": "uv",
        "dimensions": [
          "channel",
          "region",
          "device_type",
          "user_level",
          "platform"
        ]
      },
      {
        "metric": "pv",
        "dimensions": [
          "channel",
          "region",
          "device_type",
          "platform",
          "page_type"
        ]
      },
      {
        "metric": "gmv",
        "dimensions": [
          "channel",
          "region",
          "device_type",
          "user_level",
          "product_category"
        ]
      },
      {
        "metric": "aov",
        "dimensions": [
