{
  "time_phrases": [
    {"phrases": ["最近一年", "近一年", "近12个月", "本年", "今年"], "window_months": 12}
  ],
  "filters": [
    {"phrases": ["自然", "自然流量", "organic"], "field": "channel_subtype", "operator": "IN", "value": "organic"},
    {"phrases": ["扫码", "二维码", "qrcode"], "field": "channel_subtype", "operator": "IN", "value": "qrcode"},
    {"phrases": ["安卓", "android"], "field": "os_version", "operator": "LIKE_ANY", "value": "Android%"},
    {"phrases": ["苹果", "ios"], "field": "os_version", "operator": "LIKE_ANY", "value": "iOS%"}
  ],
  "group_by": [
    {"phrases": ["设备型号", "device model", "device_model"], "column": "device_model"},
    {"phrases": ["国家", "country"], "column": "country"},
    {"phrases": ["城市", "city"], "column": "city"},
    {"phrases": ["网络类型", "network_type", "网络环境"], "column": "network_type"},
    {"phrases": ["渠道子类型", "channel_subtype", "细分渠道"], "column": "channel_subtype"},
    {"phrases": ["AB测试", "ab_bucket", "实验分组"], "column": "ab_bucket"},
    {"phrases": ["用户分群", "user_segment", "用户群体"], "column": "user_segment"},
    {"phrases": ["操作系统版本", "os_version", "系统版本"], "column": "os_version"},
    {"phrases": ["产品类别", "product_category", "商品类别", "品类"], "column": "product_category"},
    {"phrases": ["支付方式", "payment_method", "付款方式"], "column": "payment_method"},
    {"phrases": ["年龄组", "user_age_group", "年龄段"], "column": "user_age_group"},
    {"phrases": ["性别", "user_gender", "用户性别"], "column": "user_gender"},
    {"phrases": ["订单状态", "order_status", "交易状态"], "column": "order_status"},
    {"phrases": ["配送方式", "delivery_method", "物流方式"], "column": "delivery_method"},
    {"phrases": ["营销来源", "marketing_source", "推广来源"], "column": "marketing_source"},
    {"phrases": ["VIP等级", "user_vip_level", "会员等级"], "column": "user_vip_level"},
    {"phrases": ["时段", "time_period", "时间段"], "column": "time_period"}
  ]
}




